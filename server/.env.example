# PORT sur lequel le serveur Express démarre (optionnel, 5000 par défaut si absent)
PORT=5000

# Firebase Console → Paramètres du projet → Comptes de service → Générer une nouvelle clé privée (champ "project_id" du JSON téléchargé)
FIREBASE_ADMIN_PROJECT_ID=bana-frites-12345

# Même fichier JSON de compte de service (champ "client_email")
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@bana-frites-12345.iam.gserviceaccount.com

# Même fichier JSON de compte de service (champ "private_key") — garder les \n littéraux, ils sont convertis dans firebaseAdmin.js
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nFAKEKEYCONTENTHERE\n-----END PRIVATE KEY-----\n"

# Tableau de bord SasPay → Développeurs / API Keys → clé secrète de l'application
SASPAY_API_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX

# Montant en dollars facturé pour débloquer l'identité d'un message (ex: 1 pour 1$)
SASPAY_UNLOCK_AMOUNT=1

# Devise utilisée pour le paiement SasPay (ex: USD)
SASPAY_CURRENCY=USD

# Tableau de bord SasPay → Développeurs → Webhooks → secret de signature de l'endpoint configuré
SASPAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# URL publique du frontend en production, utilisée pour le return_url après paiement (sans slash final)
CLIENT_URL=https://banafrites.com
